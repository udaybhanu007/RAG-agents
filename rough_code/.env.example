# Multi-Agent RAG Workflow Environment Configuration

# Azure OpenAI Configuration
AZURE_OPENAI_ENDPOINT=https://your-openai-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-ada-002
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Qdrant Vector Database Configuration
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your-qdrant-api-key-here
QDRANT_COLLECTION=documents

# Neo4j Graph Database Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password-here

# LangSmith Configuration (for observability)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your-langsmith-api-key-here
LANGCHAIN_PROJECT=multi-agent-rag-workflow

# Prometheus Metrics Configuration
PROMETHEUS_PORT=9090
METRICS_ENABLED=true

# Application Configuration
LOG_LEVEL=INFO                    # DEBUG, INFO, WARNING, ERROR, CRITICAL
DEBUG_MODE=false                  # true for development, false for production
ENABLE_JSON_LOGS=false             # true for production, false for development
ENABLE_COLORED_LOGS=true         # true for development console output
API_PORT=8000
API_HOST=0.0.0.0

# Performance Configuration
MAX_CONCURRENT_QUERIES=10
QUERY_TIMEOUT_SECONDS=30
VECTOR_SEARCH_LIMIT=10
GRAPH_QUERY_LIMIT=20

# Agent Configuration
ENABLE_LLM_RERANKING=true
VALIDATION_CONFIDENCE_THRESHOLD=0.6
SYNTHESIS_MAX_TOKENS=2000
